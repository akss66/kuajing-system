[Unit]
Description=Start a missing or replace an unhealthy Tongzhouxing worker container
After=docker.service
Requires=docker.service
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
EnvironmentFile=/etc/tongzhouxing-shop/watchdog.env
ExecStart=/usr/local/lib/tongzhouxing-shop/worker-watchdog.sh ${COMPOSE_FILE} ${COMPOSE_ENV_FILE} ${APP_VERSION} ${RELEASE_SHA}
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
TimeoutStartSec=120
