DATABASE_URL=postgres://tongzhouxing:tongzhouxing@127.0.0.1:5432/tongzhouxing
TEST_DATABASE_URL=postgres://tongzhouxing:tongzhouxing@127.0.0.1:5432/tongzhouxing_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
PII_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64

# DeepSeek 智能 SKU 匹配（仅服务器读取；默认关闭）
# 先配置密钥，再打开全局开关；客户还需由超级管理员逐个授权。
AI_SKU_MATCH_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 极风官方授权（仅服务器读取；未配置时不会外呼）
# BASE_URL 与 OAuth domain 固定为经业务方确认的值，不能从请求头或页面覆盖。
# CLIENT_ID / CLIENT_SECRET 是极风开发者凭据；TOKEN_ENCRYPTION_KEY 是独立随机 32 字节 Base64URL 密钥。
# 一次性授权 token 由超级管理员在“外部集成”页面按次输入，绝不写入环境文件。
JIFENG_BASE_URL=
JIFENG_DOMAIN=
JIFENG_DEVELOPER_NAME=
JIFENG_CLIENT_ID=
JIFENG_CLIENT_SECRET=
JIFENG_TOKEN_ENCRYPTION_KEY=

# 旧版静态授权兼容（仅迁移/回退读取；新部署留空，由数据库保存加密授权状态）
JIFENG_ACCESS_TOKEN=
JIFENG_REFRESH_TOKEN=
JIFENG_USER_ID=
JIFENG_WAREHOUSE_CODE=
JIFENG_LOGISTICS_ID=

# 飞书开放平台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CARGO_SOURCE_WIKI_TOKEN=
FEISHU_CARGO_SOURCE_SHEET_ID=
# Enables a confirmed one-time import into PostgreSQL. It never grants Feishu write access.
FEISHU_CARGO_IMPORT_ENABLED=false
# Temporary pre-cutover mirror: overwrites system catalog fields and inventory from Feishu.
FEISHU_CATALOG_MIRROR_ENABLED=false
# Required when the mirror is enabled. Use an ISO-8601 timestamp with an explicit zone;
# missing or invalid values fail closed. Example: 2026-09-01T00:00:00+08:00
FEISHU_CATALOG_MIRROR_CUTOFF_AT=
# Keep false: this independently controls optional writes to a separate Feishu target sheet.
FEISHU_CARGO_WRITES_ENABLED=false
FEISHU_CARGO_TARGET_SPREADSHEET_TOKEN=
FEISHU_CARGO_TARGET_SHEET_ID=
FEISHU_INTERNAL_CHAT_ID=
CATALOG_ASSET_DIR=/app/data/catalog-assets

# 生产部署 Compose 使用；不要把真实值提交到仓库。
# 生产镜像使用当前提交的 7-40 位 Git SHA；禁止 current/latest 等可移动标签。
APP_VERSION=
# 当前提交的完整 40 位 Git SHA，用于镜像/容器发布证据。
RELEASE_SHA=
POSTGRES_DB=tongzhouxing
POSTGRES_USER=tongzhouxing_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
